#. Plugin Name of the plugin
#: bootstrap.php
#: inc/core/Admin/SettingsPage.php:124
#: inc/core/Admin/SiteHealth.php:367
msgid "Gecka Antispam"
msgstr "Gecka Antispam"

#. Description of the plugin
#: bootstrap.php
msgid "Stops spam on comments, login, registration, WooCommerce, Contact Form 7, Gravity Forms and ACF forms with a honeypot, a signed timestamp and a statistical filter trained by what you mark as spam. No external service."
msgstr "Arrête le spam sur les commentaires, la connexion, l’inscription, WooCommerce, Contact Form 7, Gravity Forms et les formulaires ACF avec un pot de miel, un horodatage signé et un filtre statistique entraîné par ce que vous marquez comme spam. Aucun service externe."

