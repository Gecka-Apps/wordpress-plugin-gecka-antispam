{
    "name": "gecka-wp-plugin/gecka-antispam",
    "type": "wordpress-plugin",
    "description": "Honeypot, signed timestamp and statistical filter for comments, login, registration, WooCommerce, Contact Form 7, Gravity Forms and ACF.",
    "keywords": [
        "wordpress",
        "plugin",
        "spam",
        "honeypot",
        "statistical-filter"
    ],
    "homepage": "https://gecka.nc",
    "support": {
        "issues": "https://github.com/Gecka-Apps/wordpress-plugin-gecka-antispam/issues",
        "source": "https://github.com/Gecka-Apps/wordpress-plugin-gecka-antispam"
    },
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Laurent Dinclaux",
            "email": "laurent@gecka.nc"
        }
    ],
    "autoload": {
        "psr-4": {
            "Gecka\\WP\\Plugin\\Antispam\\": "inc/core/"
        }
    },
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.0",
        "gecka/spamfilter": "^1.0",
        "gecka/wp-admin-menu": "^1.2.2"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.0",
        "alleyinteractive/pest-plugin-wordpress": "^1.1"
    },
    "scripts": {
        "format": "pint",
        "lint:php": [
            "pint --test",
            "phpcs"
        ],
        "analyse": "phpstan analyse --no-progress --memory-limit=2G",
        "test": "pest",
        "i18n": "bin/i18n",
        "i18n:check": "bin/i18n --check"
    }
}
